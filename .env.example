# Copy this file to `.env` for local development and fill in real values.
# `.env` is git-ignored: never commit real passwords.
# On Hostinger, set the same names in hPanel -> Web App -> Environment variables.

# --- Database (hPanel -> Databases -> MySQL Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Admin login (create both lines with: npm run hash-password) ---
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Email (your Hostinger mailbox, hPanel -> Emails) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Address shown as the sender (usually the same as SMTP_USER)
MAIL_FROM=

# --- Build target for Hostinger (not secret) ---
# NITRO_PRESET=node-server
